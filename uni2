local function createESP(char)
    if espData[char] or not char then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.7
    highlight.Adornee = char
    highlight.Parent = char

    local bill = Instance.new("BillboardGui")
    bill.Adornee = char:WaitForChild("Head")
    bill.Size = UDim2.new(4,0,3,0)
    bill.StudsOffset = Vector3.new(0,3,0)
    bill.AlwaysOnTop = true
    bill.Parent = char

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0.5,0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = char.Name
    nameLabel.TextColor3 = Color3.new(1,1,1)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 16
    nameLabel.Parent = bill

    local healthBG = Instance.new("Frame")
    healthBG.Size = UDim2.new(1,0,0.25,0)
    healthBG.Position = UDim2.new(0,0,0.55,0)
    healthBG.BackgroundColor3 = Color3.new(0,0,0)
    healthBG.Visible = healthBarEnabled
    healthBG.Parent = bill

    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1,0,1,0)
    healthBar.BackgroundColor3 = Color3.new(0,1,0)
    healthBar.Parent = healthBG

    espData[char] = {highlight, bill, healthBG, healthBar}
end

local function removeESP(char)
    if espData[char] then
        for _, v in pairs(espData[char]) do
            if v then v:Destroy() end
        end
        espData[char] = nil
    end
end

local function updateHealthBars()
    for char, data in pairs(espData) do
        if data[4] and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            data[4].Size = UDim2.new(math.clamp(hum.Health/hum.MaxHealth,0,1), 0, 1, 0)
        end
    end
end

local function toggleESP(state)
    espEnabled = state
    if state then
        espToggle.BackgroundColor3 = Color3.fromRGB(200,0,0)
        espToggle.Text = "Disable ESP (E)"
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character then
                createESP(p.Character)
            end
        end
    else
        espToggle.BackgroundColor3 = Color3.fromRGB(0,200,0)
        espToggle.Text = "Enable ESP (E)"
        for char, _ in pairs(espData) do
            removeESP(char)
        end
        espData = {}
    end
end

local function toggleHealth(state)
    healthBarEnabled = state
    if state then
        healthToggle.BackgroundColor3 = Color3.fromRGB(200,0,0)
        healthToggle.Text = "Disable Health Bars"
    else
        healthToggle.BackgroundColor3 = Color3.fromRGB(0,200,0)
        healthToggle.Text = "Enable Health Bars"
    end
    for _, data in pairs(espData) do
        if data[3] then data[3].Visible = healthBarEnabled end
    end
end

-- ==================== AIMBOT ====================
local function isVisible(targetHead)
    local camera = workspace.CurrentCamera
    local myHead = player.Character and player.Character:FindFirstChild("Head")
    if not myHead then return false end

    local ray = Ray.new(camera.CFrame.Position, (targetHead.Position - camera.CFrame.Position).Unit * 500)
    local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {player.Character})

    return hit == nil or hit:IsDescendantOf(targetHead.Parent)
end

local function getBestTarget()
    local camera = workspace.CurrentCamera
    local bestTarget = nil
    local bestScore = math.huge

    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head
            if isVisible(head) then
                local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if distFromCenter < bestScore then
                        bestScore = distFromCenter
                        bestTarget = head
                    end
                end
            end
        end
    end
    return bestTarget
end

