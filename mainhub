-- Tab switching
local function switchToTab(tabName)
    if currentTab == tabName then return end

    if currentTab then
        TweenService:Create(tabs[currentTab], TweenInfo.new(0.18, Enum.EasingStyle.Sine), {
            BackgroundColor3 = Color3.fromRGB(20,20,24)
        }):Play()
        contents[currentTab].Visible = false
    end

    currentTab = tabName
    TweenService:Create(tabs[tabName], TweenInfo.new(0.18, Enum.EasingStyle.Sine), {
        BackgroundColor3 = ACCENT_COLOR
    }):Play()
    contents[tabName].Visible = true
end

for name, btn in pairs(tabs) do
    btn.MouseButton1Click:Connect(function()
        switchToTab(name)
    end)
end

