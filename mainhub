-- ── Tab Creation ────────────────────────────────────────────────────
local tabs = {}
local contents = {}
local currentTab = nil

local function createTab(tabName, order)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = tabName .. "Tab"
    tabBtn.Size = UDim2.new(0, 110, 0, 34)
    tabBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    tabBtn.BorderSizePixel = 0
    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.Text = tabName
    tabBtn.TextColor3 = TEXT_COLOR
    tabBtn.TextSize = 14
    tabBtn.TextWrapped = true
    tabBtn.LayoutOrder = order
    tabBtn.AutoButtonColor = false
    tabBtn.Parent = tabHolder

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = tabBtn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = BORDER_COLOR
    btnStroke.Thickness = 1.5
    btnStroke.Transparency = 0.4
    btnStroke.Parent = tabBtn

    local tabContent = Instance.new("Frame")
    tabContent.Name = tabName .. "Content"
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = contentArea

    if tabName:find("Coming Soon") then
        local placeholder = Instance.new("TextLabel")
        placeholder.Size = UDim2.new(1, -40, 1, -40)
        placeholder.Position = UDim2.new(0, 20, 0, 20)
        placeholder.BackgroundTransparency = 1
        placeholder.Font = Enum.Font.GothamBold
        placeholder.Text = tabName .. "\n\nFeatures coming soon!"
        placeholder.TextColor3 = Color3.fromRGB(100, 100, 120)
        placeholder.TextSize = 22
        placeholder.TextWrapped = true
        placeholder.TextXAlignment = Enum.TextXAlignment.Center
        placeholder.TextYAlignment = Enum.TextYAlignment.Center
        placeholder.Parent = tabContent
    end

    tabs[tabName] = tabBtn
    contents[tabName] = tabContent

    return tabBtn, tabContent
end

